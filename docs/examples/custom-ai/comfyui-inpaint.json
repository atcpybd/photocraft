{
  "endpoint": "http://127.0.0.1:8188",
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "your-installed-inpainting-checkpoint.safetensors" }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "seamless continuation of the background", "clip": ["4", 1] }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["4", 1] }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": { "image": "example.png" }
    },
    "11": {
      "class_type": "LoadImageMask",
      "inputs": { "image": "example-mask.png", "channel": "red" }
    },
    "12": {
      "class_type": "VAEEncodeForInpaint",
      "inputs": {
        "pixels": ["10", 0], "mask": ["11", 0],
        "vae": ["4", 2], "grow_mask_by": 6
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 1, "steps": 20, "cfg": 7,
        "sampler_name": "euler", "scheduler": "normal", "denoise": 1,
        "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0],
        "latent_image": ["12", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": { "images": ["8", 0], "filename_prefix": "PhotoCraft" }
    }
  },
  "mappings": {
    "prompt": { "node": "6", "input": "text" },
    "image": { "node": "10", "input": "image" },
    "mask": { "node": "11", "input": "image" },
    "seed": { "node": "3", "input": "seed" },
    "output": "9"
  }
}
